# ── Database ────────────────────────────────────────────────────
# Async Postgres connection string (Supabase or Railway)
DATABASE_URL=postgresql+asyncpg://postgres:Ezhil020%40cit@db.chnrlmxvxwqxgmovnucg.supabase.co:5432/postgres
# ── LLM Providers ───────────────────────────────────────────────
# Active provider: "anthropic" or "ollama"
ACTIVE_LLM_PROVIDER=ollama

# Anthropic (cloud)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Embeddings ──────────────────────────────────────────────────
# Active embedding model: "ollama" or "openai"
ACTIVE_EMBEDDING_MODEL=ollama

# Required only if ACTIVE_EMBEDDING_MODEL=openai
OPENAI_API_KEY=sk-...

# ── Retrieval ───────────────────────────────────────────────────
# Retrieval mode: "hybrid", "vector", or "lexical"
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=8

# ── Context Window ──────────────────────────────────────────────
# Summarize older turns when history exceeds this fraction of model's context limit
CONTEXT_WINDOW_THRESHOLD=0.8

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Ingestion ───────────────────────────────────────────────────
TRANSCRIPT_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts
INGEST_LIMIT=50
